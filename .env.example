# Django settings
SECRET_KEY=your_secret_key_here          # Секретный ключ Django (обязательно замените!)
DEBUG=False                              # Режим отладки (False для продакшена)
ALLOWED_HOSTS=your-domain.com,ip-address # Домены и IP-адреса сервера

# Database
POSTGRES_USER=your_db_user               # Имя пользователя PostgreSQL
POSTGRES_PASSWORD=your_db_password       # Пароль PostgreSQL
POSTGRES_DB=your_db_name                 # Название базы данных
DB_HOST=your_db_host                     # Хост БД (db - для Docker Compose)
DB_PORT=5432                             # Порт PostgreSQL